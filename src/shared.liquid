<style>
  .vt-board {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    overflow: hidden;
  }

  .vt-cols {
    width: 100%;
    align-items: start;
    column-gap: 18px;
    row-gap: 10px;
  }

  .screen--lg .vt-cols {
    column-gap: 20px;
    row-gap: 16px;
  }

  .vt-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .screen:not(.screen--portrait) .vt-cols--split .vt-col:nth-child(2) {
    border-left: 2px solid #000000;
    padding-left: 16px;
  }

  .screen--lg:not(.screen--portrait) .vt-cols--split .vt-col:nth-child(2) {
    padding-left: 18px;
  }

  .vt-station {
    margin-bottom: 8px;
  }

  .screen--lg .vt-station {
    margin-bottom: 14px;
  }

  .vt-station:last-child {
    margin-bottom: 0;
  }

  .vt-station__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    border-bottom: 2px solid #000000;
    padding-bottom: 3px;
    margin-bottom: 3px;
  }

  .screen--lg .vt-station__header {
    padding-bottom: 5px;
    margin-bottom: 5px;
  }

  .vt-station__name {
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .vt-station__hint {
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .vt-row {
    display: grid;
    grid-template-columns: 22px 46px minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 8px;
    padding: 5px 0;
    border-bottom: 1px solid #000000;
  }

  .screen--lg .vt-row {
    grid-template-columns: 28px 58px minmax(0, 1fr) auto;
    column-gap: 12px;
    padding: 8px 0;
  }

  .vt-row--large {
    grid-template-columns: 26px 56px minmax(0, 1fr) auto;
    column-gap: 10px;
    padding: 8px 0;
  }

  .screen--lg .vt-row--large {
    grid-template-columns: 34px 72px minmax(0, 1fr) auto;
    column-gap: 14px;
    padding: 12px 0;
  }

  .vt-row--compact {
    grid-template-columns: 20px 42px minmax(0, 1fr) auto;
    column-gap: 6px;
    padding: 4px 0;
  }

  .screen--lg .vt-row--compact {
    grid-template-columns: 26px 54px minmax(0, 1fr) auto;
    column-gap: 10px;
    padding: 7px 0;
  }

  .vt-row--quad {
    grid-template-columns: 18px 38px minmax(0, 1fr) auto;
    column-gap: 5px;
    padding: 2px 0;
  }

  .screen--lg .vt-row--quad {
    grid-template-columns: 24px 50px minmax(0, 1fr) auto;
    column-gap: 8px;
    padding: 4px 0;
  }

  .screen--lg:not(.screen--portrait) .vt-row--full-single {
    grid-template-columns: 28px 68px minmax(0, 1fr) auto;
    column-gap: 8px;
    padding: 13px 0;
  }

  .vt-row--stacked {
    grid-template-columns: 22px 46px minmax(0, 1fr);
    row-gap: 3px;
  }

  .screen--lg .vt-row--stacked {
    grid-template-columns: 28px 58px minmax(0, 1fr);
    row-gap: 4px;
  }

  .screen--lg:not(.screen--portrait) .vt-row--full-single.vt-row--stacked {
    grid-template-columns: 28px 68px minmax(0, 1fr);
    row-gap: 5px;
  }

  .vt-row--compact.vt-row--stacked {
    grid-template-columns: 20px 42px minmax(0, 1fr);
    row-gap: 2px;
  }

  .screen--lg .vt-row--compact.vt-row--stacked {
    grid-template-columns: 26px 54px minmax(0, 1fr);
    row-gap: 3px;
  }

  .vt-row--quad.vt-row--stacked {
    grid-template-columns: 18px 38px minmax(0, 1fr);
    row-gap: 2px;
  }

  .screen--lg .vt-row--quad.vt-row--stacked {
    grid-template-columns: 24px 50px minmax(0, 1fr);
    row-gap: 3px;
  }

  .vt-row--stacked .vt-times--ownline {
    grid-column: 2 / -1;
    justify-content: flex-start;
    flex-wrap: wrap;
    row-gap: 2px;
  }

  .vt-station > .vt-row:last-child,
  .vt-col > .vt-row:last-child,
  .vt-station > .hidden:last-child .vt-row,
  .vt-col > .hidden:last-child .vt-row {
    border-bottom: none;
  }

  .vt-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  .screen--lg .vt-icon {
    width: 28px;
    height: 28px;
  }

  .vt-row--large .vt-icon {
    width: 26px;
    height: 26px;
  }

  .screen--lg .vt-row--large .vt-icon {
    width: 34px;
    height: 34px;
  }

  .vt-row--compact .vt-icon {
    width: 20px;
    height: 20px;
  }

  .screen--lg .vt-row--compact .vt-icon {
    width: 26px;
    height: 26px;
  }

  .vt-row--quad .vt-icon {
    width: 18px;
    height: 18px;
  }

  .screen--lg .vt-row--quad .vt-icon {
    width: 24px;
    height: 24px;
  }

  .vt-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .vt-line {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    text-align: center;
    white-space: nowrap;
    box-sizing: border-box;
    padding: 2px 4px;
    border-radius: 4px;
  }

  .vt-line--sbahn {
    border-radius: 999px;
  }

  .vt-line--tram {
    box-shadow: inset 0 0 0 1px #ffffff, inset 0 0 0 2.5px #000000;
  }

  .vt-dest {
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .vt-dest__to {
    display: block;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .vt-dest__stop {
    display: block;
    max-width: 100%;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .vt-times {
    display: inline-flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 5px;
    white-space: nowrap;
  }

  .screen--lg .vt-times {
    gap: 8px;
  }

  .screen--lg:not(.screen--portrait) .vt-row--full-single .vt-times {
    gap: 6px;
  }

  .vt-t {
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
  }

  .vt-t--sched {
    font-style: italic;
  }

  .vt-delay {
    padding: 1px 4px;
    border-radius: 3px;
    vertical-align: top;
  }

  .vt-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100%;
    padding: 20px;
    gap: 10px;
  }

  .vt-title-icon {
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: 6px;
  }

  .vt-live-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .vt-live-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #000000;
  }
</style>

{% template mode_icon %}
  {% if mode == "metro" %}
    <svg viewBox="0 0 24 24" aria-label="U-Bahn">
      <rect x="1" y="1" width="22" height="22" rx="4" fill="#000"/>
      <path d="M7.2 5.5h3.1v8.2c0 1.4.7 2.2 1.7 2.2s1.7-.8 1.7-2.2V5.5h3.1v8.1c0 3.2-1.9 5.1-4.8 5.1s-4.8-1.9-4.8-5.1V5.5z" fill="#fff"/>
    </svg>
  {% elsif mode == "sbahn" %}
    <svg viewBox="0 0 24 24" aria-label="S-Bahn">
      <circle cx="12" cy="12" r="11" fill="#000"/>
      <path d="M15.8 8.3c-.7-.8-2-1.3-3.5-1.3-1.8 0-3 .7-3 1.7 0 1 1 1.4 2.9 1.8l1.2.2c3 .6 4.4 1.8 4.4 3.9 0 2.7-2.3 4.4-5.9 4.4-2.6 0-4.7-.9-5.8-2.3l1.9-1.9c.9 1 2.2 1.6 4 1.6 1.8 0 3-.7 3-1.7 0-.9-.7-1.4-2.5-1.7l-1.4-.3c-2.8-.6-4.5-1.8-4.5-3.9 0-2.6 2.3-4.3 5.7-4.3 2.3 0 4.2.7 5.3 1.9l-1.8 1.9z" fill="#fff"/>
    </svg>
  {% elsif mode == "bus" %}
    <svg viewBox="0 0 24 24" aria-label="Bus">
      <rect x="3" y="2.5" width="18" height="16.5" rx="3" fill="#000"/>
      <rect x="5.2" y="5" width="13.6" height="6.8" rx="1.2" fill="#fff"/>
      <circle cx="7.4" cy="15.4" r="1.4" fill="#fff"/>
      <circle cx="16.6" cy="15.4" r="1.4" fill="#fff"/>
      <rect x="5.5" y="19" width="3.2" height="2.6" rx="1" fill="#000"/>
      <rect x="15.3" y="19" width="3.2" height="2.6" rx="1" fill="#000"/>
    </svg>
  {% else %}
    <svg viewBox="0 0 24 24" aria-label="Tram">
      <path d="M8.5 2h7M12 2v3" stroke="#000" stroke-width="2" stroke-linecap="round"/>
      <rect x="4" y="5" width="16" height="14" rx="3" fill="#000"/>
      <rect x="6" y="7.2" width="12" height="5.5" rx="1" fill="#fff"/>
      <circle cx="8" cy="15.8" r="1.2" fill="#fff"/>
      <circle cx="16" cy="15.8" r="1.2" fill="#fff"/>
      <path d="M7.5 19l-1.5 3M16.5 19l1.5 3M6 22h12" stroke="#000" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  {% endif %}
{% endtemplate %}

{% template dep_time %}
  {% if dep %}
    <span class="vt-t{% if dep.s %} vt-t--sched{% endif %}">
      {% if primary %}
        {% if density == "large" %}
          {% assign t_cls = "value value--xsmall lg:value--small value--tnums" %}
        {% elsif density == "full_single" %}
          {% assign t_cls = "value value--xxsmall lg:value--xsmall lg:landscape:value--small lg:landscape:text--bold value--tnums" %}
        {% elsif density == "quad" %}
          {% assign t_cls = "label label--base lg:label--large value--tnums" %}
        {% else %}
          {% assign t_cls = "value value--xxsmall lg:value--xsmall value--tnums" %}
        {% endif %}
      {% else %}
        {% if density == "large" %}
          {% assign t_cls = "label label--base lg:label--large value--tnums" %}
        {% elsif density == "full_single" %}
          {% assign t_cls = "label label--small lg:label--base lg:landscape:label--large value--tnums" %}
        {% else %}
          {% assign t_cls = "label label--small lg:label--base value--tnums" %}
        {% endif %}
      {% endif %}
      <span class="{{ t_cls }}">
        {% if time_display == "minutes" %}
          {% if dep.s %}~{% endif %}{{ dep.m }}&#8242;
        {% elsif time_display == "clock_and_min" %}
          {% if dep.s %}~{% endif %}{{ dep.t }} ({{ dep.m }}&#8242;)
        {% else %}
          {% if dep.s %}~{% endif %}{{ dep.t }}
        {% endif %}
      </span>
      {% if dep.d and dep.d > 0 %}
        <span class="label label--small label--inverted vt-delay">+{{ dep.d }}</span>
      {% endif %}
    </span>
  {% endif %}
{% endtemplate %}

{% template route_row %}
  {% assign lim = max_times | default: 4 %}
  {% assign stack = stack_times | default: false %}
  {% assign dens = density | default: "normal" %}
  {% assign should_stack = false %}
  {% if stack %}
    {% if row.ts.size >= 3 and lim >= 3 %}
      {% assign should_stack = true %}
    {% elsif time_display == "clock_and_min" and row.ts.size >= 2 and lim >= 2 %}
      {% assign should_stack = true %}
    {% elsif row.ts.size >= 2 and lim >= 2 %}
      {% if row.ts.first.d or row.ts.last.d %}
        {% assign should_stack = true %}
      {% endif %}
    {% endif %}
  {% endif %}

  {% if dens == "large" %}
    {% assign row_cls = "vt-row vt-row--large" %}
    {% assign line_size = "label label--base lg:label--large" %}
    {% assign dest_cls = "title title--base lg:title--large vt-dest__to" %}
  {% elsif dens == "full_single" %}
    {% assign row_cls = "vt-row vt-row--full-single" %}
    {% assign line_size = "label label--small lg:label--base lg:landscape:title--large" %}
    {% assign dest_cls = "title title--small lg:title--base lg:landscape:title--large vt-dest__to" %}
  {% elsif dens == "compact" %}
    {% assign row_cls = "vt-row vt-row--compact" %}
    {% assign line_size = "label label--small lg:label--base" %}
    {% assign dest_cls = "label label--base lg:label--large vt-dest__to" %}
  {% elsif dens == "quad" %}
    {% assign row_cls = "vt-row vt-row--quad" %}
    {% assign line_size = "label label--small lg:label--base" %}
    {% assign dest_cls = "label label--small lg:label--base vt-dest__to" %}
  {% else %}
    {% assign row_cls = "vt-row" %}
    {% assign line_size = "label label--small lg:label--base" %}
    {% assign dest_cls = "title title--small lg:title--base vt-dest__to" %}
  {% endif %}

  {% if row.mode == "metro" or row.mode == "sbahn" %}
    {% assign badge_variant = "label--inverted" %}
  {% else %}
    {% assign badge_variant = "label--outline" %}
  {% endif %}

  <div class="{{ row_cls }}{% if should_stack %} vt-row--stacked{% endif %}">
    <span class="vt-icon">
      {% render "mode_icon", mode: row.mode %}
    </span>
    <span class="{{ line_size }} {{ badge_variant }} vt-line vt-line--{{ row.mode }}">{{ row.line }}</span>
    <div class="vt-dest">
      <span class="{{ dest_cls }}" data-clamp="1">{{ row.to }}</span>
      {% if show_stop and row.stop %}
        <span class="description description--base lg:description--large vt-dest__stop" data-clamp="1">{{ row.stop }}</span>
      {% endif %}
    </div>
    <div class="vt-times{% if should_stack %} vt-times--ownline{% endif %}">
      {% for dep in row.ts limit: lim %}
        {% if forloop.index > 1 %}<span class="label label--small lg:label--base{% if dens == "full_single" %} lg:landscape:label--large{% endif %}">&middot;</span>{% endif %}
        {% render "dep_time", dep: dep, primary: forloop.first, time_display: time_display, density: dens %}
      {% endfor %}
    </div>
  </div>
{% endtemplate %}

{% template vt_title_bar %}
  <div class="title_bar">
    <span class="vt-title-icon">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <rect x="1" y="1" width="22" height="22" rx="4" fill="#000"/>
        <path d="M5.5 7.5h13M12 7.5v9.5M7 17h10" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
    </span>
    <span class="title">{{ title | default: "Vienna Transit" }}</span>
    <span class="instance">
      <span class="vt-live-pill">
        {% if rt_only %}<span class="vt-live-dot"></span>LIVE &middot; {% endif %}Updated {{ updated | default: "--:--" }}
      </span>
    </span>
  </div>
{% endtemplate %}
