<div class="layout layout--col layout--top">
  <div class="vt-board">
    {% if empty_message %}
      <div class="vt-empty">
        <div class="title title--base lg:title--large">{{ title | default: "Vienna Transit" }}</div>
        <div class="description description--large lg:description--xlarge">{{ empty_message }}</div>
      </div>
    {% elsif stop_count == 1 and route_count <= 7 %}
      <div class="grid grid--cols-1 vt-cols">
        <div class="vt-col">
          {% for stop in stops %}
            <div class="vt-station">
              <div class="vt-station__header">
                <span class="title title--small lg:title--base vt-station__name">{{ stop.name }}</span>
                <span class="label label--small lg:label--base vt-station__hint">Next {{ times_per_route | default: 2 }} {% if rt_only %}Real {% endif %}Times</span>
              </div>
              {% for route in stop.routes limit: 7 %}
                {% render "route_row", row: route, time_display: time_display, density: "large", show_stop: false, max_times: 4, stack_times: false %}
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% elsif stop_count >= 2 %}
      {% assign og_col_budget = 9 %}
      {% if times_per_route >= 3 or time_display == "clock_and_min" %}{% assign og_col_budget = 6 %}{% endif %}
      {% assign x_col_budget = 10 %}
      {% if times_per_route >= 3 or time_display == "clock_and_min" %}{% assign x_col_budget = 7 %}{% endif %}
      <div class="grid grid--cols-2 portrait:grid--cols-1 vt-cols vt-cols--split">
        <div class="vt-col">
          {% assign left_used = 0 %}
          {% for stop in stops %}
            {% if stop.col == "L" and left_used < x_col_budget %}
              {% assign hdr_lg_only = false %}
              {% if left_used >= og_col_budget %}{% assign hdr_lg_only = true %}{% endif %}
              <div class="vt-station{% if hdr_lg_only %} hidden lg:visible{% endif %}">
                <div class="vt-station__header">
                  <span class="title title--small lg:title--base vt-station__name">{{ stop.name }}</span>
                  <span class="label label--small lg:label--base vt-station__hint">{% if rt_only %}Real Time{% else %}Departures{% endif %}</span>
                </div>
                {% assign left_used = left_used | plus: 1 %}
                {% for route in stop.routes %}
                  {% if left_used < x_col_budget %}
                    {% if left_used >= og_col_budget and hdr_lg_only == false %}
                      <div class="hidden lg:visible">
                        {% render "route_row", row: route, time_display: time_display, density: "normal", show_stop: false, max_times: 4, stack_times: true %}
                      </div>
                    {% else %}
                      {% render "route_row", row: route, time_display: time_display, density: "normal", show_stop: false, max_times: 4, stack_times: true %}
                    {% endif %}
                    {% assign left_used = left_used | plus: 1 %}
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="vt-col">
          {% assign right_used = 0 %}
          {% for stop in stops %}
            {% if stop.col == "R" and right_used < x_col_budget %}
              {% assign hdr_lg_only = false %}
              {% if right_used >= og_col_budget %}{% assign hdr_lg_only = true %}{% endif %}
              <div class="vt-station{% if hdr_lg_only %} hidden lg:visible{% endif %}">
                <div class="vt-station__header">
                  <span class="title title--small lg:title--base vt-station__name">{{ stop.name }}</span>
                  <span class="label label--small lg:label--base vt-station__hint">{% if rt_only %}Real Time{% else %}Departures{% endif %}</span>
                </div>
                {% assign right_used = right_used | plus: 1 %}
                {% for route in stop.routes %}
                  {% if right_used < x_col_budget %}
                    {% if right_used >= og_col_budget and hdr_lg_only == false %}
                      <div class="hidden lg:visible">
                        {% render "route_row", row: route, time_display: time_display, density: "normal", show_stop: false, max_times: 4, stack_times: true %}
                      </div>
                    {% else %}
                      {% render "route_row", row: route, time_display: time_display, density: "normal", show_stop: false, max_times: 4, stack_times: true %}
                    {% endif %}
                    {% assign right_used = right_used | plus: 1 %}
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% else %}
      {% assign single_stop = stops.first %}
      {% assign og_per_col = 8 %}
      {% assign x_per_col = 12 %}
      {% if times_per_route >= 3 or time_display == "clock_and_min" %}
        {% assign og_per_col = 6 %}
        {% assign x_per_col = 10 %}
      {% endif %}
      {% assign half = single_stop.routes.size | plus: 1 | divided_by: 2 %}
      {% if half > x_per_col %}{% assign half = x_per_col %}{% endif %}
      <div class="vt-station">
        <div class="vt-station__header">
          <span class="title title--small lg:title--base vt-station__name">{{ single_stop.name }}</span>
          <span class="label label--small lg:label--base vt-station__hint">Next {{ times_per_route | default: 2 }} {% if rt_only %}Real {% endif %}Times &middot; All Directions</span>
        </div>
      </div>
      <div class="grid grid--cols-2 portrait:grid--cols-1 vt-cols vt-cols--split">
        <div class="vt-col">
          {% for route in single_stop.routes limit: half %}
            {% if forloop.index > og_per_col %}
              <div class="hidden lg:visible">
                {% render "route_row", row: route, time_display: time_display, density: "normal", show_stop: false, max_times: 4, stack_times: true %}
              </div>
            {% else %}
              {% render "route_row", row: route, time_display: time_display, density: "normal", show_stop: false, max_times: 4, stack_times: true %}
            {% endif %}
          {% endfor %}
        </div>
        <div class="vt-col">
          {% for route in single_stop.routes offset: half limit: x_per_col %}
            {% if forloop.index > og_per_col %}
              <div class="hidden lg:visible">
                {% render "route_row", row: route, time_display: time_display, density: "normal", show_stop: false, max_times: 4, stack_times: true %}
              </div>
            {% else %}
              {% render "route_row", row: route, time_display: time_display, density: "normal", show_stop: false, max_times: 4, stack_times: true %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% render "vt_title_bar", title: title, updated: updated, rt_only: rt_only %}
