<div class="layout layout--col layout--top">
  <div class="vt-board">
    {% if empty_message %}
      <div class="vt-empty">
        <div class="title title--base lg:title--large">{{ title | default: "Vienna Transit" }}</div>
        <div class="description description--large lg:description--xlarge">{{ empty_message }}</div>
      </div>
    {% else %}
      {% assign show_stop_sub = false %}
      {% if stop_count > 1 %}{% assign show_stop_sub = true %}{% endif %}
      {% assign og_per_col = 3 %}
      {% assign xl_per_col = 4 %}
      {% assign xp_per_col = 5 %}
      {% if times_per_route >= 3 or time_display == "clock_and_min" %}
        {% assign og_per_col = 2 %}
        {% assign xl_per_col = 3 %}
        {% assign xp_per_col = 5 %}
      {% endif %}
      {% assign col_split = rows.size | plus: 1 | divided_by: 2 %}
      {% if col_split > xp_per_col %}{% assign col_split = xp_per_col %}{% endif %}
      {% if stop_count == 1 %}
        <div class="vt-station">
          <div class="vt-station__header">
            <span class="title title--small lg:title--base vt-station__name">{{ stops.first.name }}</span>
            <span class="label label--small lg:label--base vt-station__hint">Next {{ times_per_route | default: 2 }} {% if rt_only %}Real {% endif %}Times</span>
          </div>
        </div>
      {% endif %}
      <div class="grid grid--cols-2 vt-cols vt-cols--split">
        <div class="vt-col">
          {% for row in rows limit: col_split %}
            {% if forloop.index > xl_per_col %}
              <div class="hidden lg:portrait:visible">
                {% render "route_row", row: row, time_display: time_display, density: "compact", show_stop: show_stop_sub, max_times: 4, stack_times: true %}
              </div>
            {% elsif forloop.index > og_per_col %}
              <div class="hidden lg:visible">
                {% render "route_row", row: row, time_display: time_display, density: "compact", show_stop: show_stop_sub, max_times: 4, stack_times: true %}
              </div>
            {% else %}
              {% render "route_row", row: row, time_display: time_display, density: "compact", show_stop: show_stop_sub, max_times: 4, stack_times: true %}
            {% endif %}
          {% endfor %}
        </div>
        <div class="vt-col">
          {% for row in rows offset: col_split limit: col_split %}
            {% if forloop.index > xl_per_col %}
              <div class="hidden lg:portrait:visible">
                {% render "route_row", row: row, time_display: time_display, density: "compact", show_stop: show_stop_sub, max_times: 4, stack_times: true %}
              </div>
            {% elsif forloop.index > og_per_col %}
              <div class="hidden lg:visible">
                {% render "route_row", row: row, time_display: time_display, density: "compact", show_stop: show_stop_sub, max_times: 4, stack_times: true %}
              </div>
            {% else %}
              {% render "route_row", row: row, time_display: time_display, density: "compact", show_stop: show_stop_sub, max_times: 4, stack_times: true %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% render "vt_title_bar", title: title, updated: updated, rt_only: rt_only %}
